PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
TZ=Asia/Tashkent

# Required in production: public Telegram mini-app URL used by the bot.
# In non-production this falls back to REPLIT_DEV_DOMAIN or an example URL.
# In production the process refuses to start the bot without this value.
MINI_APP_URL=https://mini-app.example.com/

# Optional: enables Telegram bot login/deep links.
TELEGRAM_BOT_TOKEN=

# Required in production: Telegram webhook URL (public HTTPS endpoint).
# Example: https://api.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Required in production: secret token verified against
# the X-Telegram-Bot-Api-Secret-Token header. Fail-closed in prod.
TELEGRAM_WEBHOOK_SECRET=

# Optional: application logging level.
LOG_LEVEL=info

# Optional: private Ollama service URL for background AI.
OLLAMA_URL=http://ollama-ai.railway.internal:11434

# Optional: selected Ollama model.
OLLAMA_MODEL=gemma3:4b

# Optional: OCR engine. "tesseract" is fastest/reliable in Railway.
# Use "paddle" for PaddleOCR only, or "auto" to try Tesseract then Paddle.
OCR_ENGINE=tesseract

# Optional: max OCR processing time per image in milliseconds.
OCR_TIMEOUT_MS=90000

# Optional: object-storage search paths for public files.
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional: local/private object directory.
PRIVATE_OBJECT_DIR=

# Optional: filesystem storage directory for scanned document images.
# In Railway, mount a persistent volume here, for example /data/uploads.
FILE_STORAGE_DIR=

# Optional: max scanned-image upload size in bytes (default: 12582912).
FILE_STORAGE_MAX_BYTES=12582912

# Optional: Express trust-proxy setting (true, false, or number of hops).
# Set to "true" in Railway / behind a reverse proxy.
TRUST_PROXY=false

# Required in production (together with MINI_APP_URL and/or EXTRA_CORS_ORIGINS):
# at least one allowed origin must be configured or the process refuses to start.
ADMIN_URL=

# Optional: comma-separated extra origins allowed by CORS.
# Counts toward the production CORS allow-list alongside ADMIN_URL/MINI_APP_URL.
EXTRA_CORS_ORIGINS=

# Optional: session token TTL in milliseconds (default: 7 days = 604800000).
SESSION_TTL_MS=604800000

# Optional: set to "production" in deployed environments.
NODE_ENV=development
