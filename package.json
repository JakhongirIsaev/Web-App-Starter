{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/check-package-manager.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "build:api-server": "pnpm --filter @workspace/api-server run build",
    "build:admin": "pnpm --filter @workspace/admin run build",
    "build:mini-app": "pnpm --filter @workspace/mini-app run build",
    "start:api-server": "sh ./artifacts/api-server/start.sh",
    "start:admin": "pnpm --filter @workspace/admin run start",
    "start:mini-app": "pnpm --filter @workspace/mini-app run start",
    "reseed:api-server-demo": "pnpm exec tsx artifacts/api-server/src/reseed-demo.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "tsx": "catalog:"
  }
}
