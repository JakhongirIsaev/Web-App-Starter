NODE_ENV=development
PORT=8001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minerva

# Public app URLs used for strict CORS
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
MINI_APP_URL=http://localhost:3001/mini-app

# Auth/session settings
SESSION_TTL_DAYS=30

# Telegram bot
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=

# AI and object storage
ANTHROPIC_API_KEY=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
PYTHON_EXECUTABLE=

# Safe local bootstrap / seeding
BOOTSTRAP_SUPERADMIN_TELEGRAM_ID=
BOOTSTRAP_SUPERADMIN_NAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_PASSWORD_HASH=
ALLOW_DEMO_SEED=true
DEMO_SEED_PASSWORD=
